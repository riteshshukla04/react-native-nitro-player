########################################
# Basic config
########################################
PORT=3000
NODE_ENV=development
HOST = localhost
ENABLE_CACHE = true

########################################
# Quoted values
########################################
DB_NAME="my database"
DB_USER='admin'
DB_PASS="p@ss word with spaces"

########################################
# Special characters & URLs
########################################
JWT_SECRET=abc$#@!^&*()_+=-
REGEX_PATTERN=^[a-zA-Z0-9_]+$
DATABASE_URL=postgres://user:pass@host:5432/db?ssl=true
TOKEN=abc=def=ghi
URL=https://example.com/api?x=1&y=2

########################################
# Empty & null-like
########################################
EMPTY=
NULL_VALUE=""
UNDEFINED_VALUE=''

########################################
# Comments
########################################
# This is a full line comment
INLINE_COMMENT=hello # this is inline comment

########################################
# Escaped characters
########################################
NEWLINE="hello\nworld"
TAB="hello\tworld"
BACKSLASH="C:\\Program Files\\App"

########################################
# Export syntax (bash style)
########################################
export EXPORTED_PORT=8080
export EXPORTED_ENV=production

########################################
# Numbers, booleans, strings
########################################
INT_VALUE=42
FLOAT_VALUE=3.14
BOOL_TRUE=true
BOOL_FALSE=false
STRING_NUMBER="42"

########################################
# Duplicate keys (last one should win)
########################################
DUP_KEY=first
DUP_KEY=second

########################################
# Variable expansion / references
########################################
BASE_HOST=localhost
BASE_PORT=3000
BASE_URL=http://localhost:3000


########################################
# Weird but valid keys
########################################
__PRIVATE__=secret
_123=numbered
A_B_C=value

########################################
# Unicode & emoji
########################################
APP_NAME=नमस्ते🚀
CURRENCY=₹
EMOJI=🔥

########################################
# Multiline value (private key style)
########################################
PRIVATE_KEY="-----BEGIN KEY-----
line1
line2
-----END KEY-----"

########################################
# Trailing spaces (intentional)    
########################################
TRAILING_SPACE=hello    
ANOTHER_TRAILING=world    

########################################
# Equals inside value
########################################
EQUALS_IN_VALUE=a=b=c=d

########################################
# Some broken / edge lines (to test robustness)
########################################
=novalue
NO_EQUALS_LINE
"UNFINISHED_QUOTE=oops

########################################
# End of file
########################################
